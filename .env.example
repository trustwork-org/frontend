# Privy App ID — get from https://dashboard.privy.io
VITE_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# Ethereum Sepolia RPC URL
# Free public default: https://ethereum-sepolia-rpc.publicnode.com
# For production-grade reliability use Alchemy or Infura:
# https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# WalletConnect / Reown Project ID — get from https://cloud.reown.com
# Required for mobile wallet QR connections; optional for extension wallets
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Pinata IPFS — get from https://app.pinata.cloud
# JWT scoped to pinFileToIPFS + pinJSONToIPFS
VITE_PINATA_JWT=YOUR_PINATA_JWT
VITE_PINATA_GATEWAY=your-name.mypinata.cloud

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3001

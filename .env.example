# Privy App ID — get from https://dashboard.privy.io
VITE_PRIVY_APP_ID=YOUR_PRIVY_APP_ID

# Ethereum Sepolia RPC — primary endpoint
# Use Alchemy or Infura for reliable performance:
#   Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   Infura:  https://sepolia.infura.io/v3/YOUR_KEY
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional second RPC. If set, the app automatically rotates to this one when
# the primary errors or rate-limits, then back when it recovers. Use a different
# provider than the primary so a single provider outage doesn't take you down.
# A free public RPC is also appended as last-ditch fallback automatically.
VITE_SEPOLIA_RPC_URL_FALLBACK=

# WalletConnect / Reown Project ID — get from https://cloud.reown.com
# Required for mobile wallet QR connections; optional for extension wallets
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Pinata IPFS — get from https://app.pinata.cloud
# JWT scoped to pinFileToIPFS + pinJSONToIPFS
VITE_PINATA_JWT=YOUR_PINATA_JWT
VITE_PINATA_GATEWAY=your-name.mypinata.cloud

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3001
